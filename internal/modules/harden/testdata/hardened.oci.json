{
  "ociVersion": "1.0.2",
  "annotations": {
    "org.opencontainers.image.title": "payments-api",
    "org.opencontainers.image.apparmorProfile": "dsecrat-payments-api"
  },
  "process": {
    "user": { "uid": 1000, "gid": 1000 },
    "noNewPrivileges": true,
    "capabilities": { "bounding": ["CAP_NET_BIND_SERVICE"], "effective": ["CAP_NET_BIND_SERVICE"] },
    "env": ["PATH=/usr/bin"]
  },
  "root": { "path": "rootfs", "readonly": true },
  "mounts": [
    { "destination": "/data", "source": "/srv/payments/data", "type": "bind", "options": ["ro", "nosuid", "nodev"] }
  ],
  "linux": {
    "namespaces": [
      { "type": "pid" }, { "type": "network" }, { "type": "ipc" },
      { "type": "mount" }, { "type": "uts" }, { "type": "user" }
    ],
    "uidMappings": [{ "containerID": 0, "hostID": 100000, "size": 65536 }],
    "maskedPaths": ["/proc/kcore", "/proc/sysrq-trigger", "/proc/latency_stats"],
    "readonlyPaths": ["/proc/sys", "/proc/sysrq-trigger"],
    "seccomp": { "defaultAction": "SCMP_ACT_ERRNO", "architectures": ["SCMP_ARCH_X86_64"] },
    "resources": {
      "memory": { "limit": 536870912 },
      "pids": { "limit": 128 },
      "devices": [{ "allow": false, "access": "rwm" }]
    }
  }
}
